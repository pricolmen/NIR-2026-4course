set(telemetry_sanitizer_names "")
if(TELEMETRY_ENABLE_ASAN)
    list(APPEND telemetry_sanitizer_names address)
endif()
if(TELEMETRY_ENABLE_UBSAN)
    list(APPEND telemetry_sanitizer_names undefined)
endif()

if(telemetry_sanitizer_names)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
        message(FATAL_ERROR "Requested sanitizers require a supported Clang/GCC compiler")
    endif()
    list(JOIN telemetry_sanitizer_names "," telemetry_sanitizer_list)
    set(telemetry_sanitizer_flag "-fsanitize=${telemetry_sanitizer_list}")
    include(CMakePushCheckState)
    include(CheckCXXSourceCompiles)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_FLAGS "${telemetry_sanitizer_flag}")
    set(CMAKE_REQUIRED_LINK_OPTIONS "${telemetry_sanitizer_flag}")
    # Recheck if the sanitizer selection changed in an existing build tree.
    unset(TELEMETRY_SANITIZERS_SUPPORTED CACHE)
    check_cxx_source_compiles("int main() { return 0; }" TELEMETRY_SANITIZERS_SUPPORTED)
    cmake_pop_check_state()
    if(NOT TELEMETRY_SANITIZERS_SUPPORTED)
        message(FATAL_ERROR "Compiler/linker cannot enable ${telemetry_sanitizer_flag}")
    endif()
endif()

function(telemetry_configure_target target)
    target_compile_features(${target} PRIVATE cxx_std_20)
    set_target_properties(${target} PROPERTIES
        CXX_STANDARD 20 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO)
    if(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang|GNU)$")
        target_compile_options(${target} PRIVATE
            -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wshadow)
    elseif(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive-)
    endif()
    if(telemetry_sanitizer_names)
        target_compile_options(${target} PRIVATE
            "${telemetry_sanitizer_flag}" -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE "${telemetry_sanitizer_flag}")
        if(TELEMETRY_ENABLE_UBSAN)
            target_compile_options(${target} PRIVATE -fno-sanitize-recover=undefined)
            target_link_options(${target} PRIVATE -fno-sanitize-recover=undefined)
        endif()
    endif()
endfunction()
